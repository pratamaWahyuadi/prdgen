# Pilih provider LLM: "deepseek" (default), "gemini", atau "tokenharbor"
LLM_PROVIDER=deepseek

# --- DeepSeek (dipakai kalau LLM_PROVIDER=deepseek) ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# --- Gemini (dipakai kalau LLM_PROVIDER=gemini) ---
# Ambil API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-flash-latest

# --- TokenHarbor (dipakai kalau LLM_PROVIDER=tokenharbor) ---
# API key berawalan thk_live_... ; model format "tokenharbor/<nama-model>"
TOKENHARBOR_API_KEY=thk_live_xxxxxxxxxxxxxxxxxxxxxxxx
TOKENHARBOR_MODEL=tokenharbor/qwen3-max
